{
  "name": "@knowall-ai/agent-pulse",
  "version": "0.1.2",
  "description": "Report what your AI agents do: AgentActivity events to Application Insights, shown in the KnowAll Agents Portal",
  "license": "MIT",
  "author": "KnowAll AI Ltd",
  "homepage": "https://github.com/knowall-ai/agent-pulse#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/knowall-ai/agent-pulse.git"
  },
  "bugs": "https://github.com/knowall-ai/agent-pulse/issues",
  "keywords": [
    "ai-agents",
    "application-insights",
    "azure",
    "observability",
    "telemetry"
  ],
  "type": "module",
  "main": "./dist/cjs/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist",
    "spec/AGENT-ACTIVITY.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.cjs.json && node scripts/mark-cjs.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run && node scripts/smoke-modules.mjs && tsc -p test/cjs-consumer",
    "check": "npm run lint && npm run typecheck && npm test",
    "prepack": "npm run build",
    "check:dist": "npm run build && git diff --exit-code -- dist"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.3"
  },
  "module": "./dist/index.js"
}
